          "_name": "header02",
          "_sourceTheme": "trustm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header02 trustm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\">\n        <input type=\"color\" title=\"Border Color\" value=\"#68707C\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/trustm5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/trustm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#e1e5f0\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc\">\n                        DIVERSE RANGE OF SERVICES\n                    </p>\n                    <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b><i>RECENT PROJECTS</i></b></h1>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        An insurance agency serves as a crucial ally in safeguarding individuals and businesses against\n                        unforeseen risks.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                            Start now\n                        </a></div>\n                    <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uFgiQyLULJ",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "header02-9"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value",
              "& when (@gradientBg)": {
                "background-image": "radial-gradient(circle farthest-side at -20% 20%, @gradientColor, @bg-value 30%)",
                "@media (max-width: 768px)": {
                  "background-image": "radial-gradient(circle farthest-side at -20% 80%, @gradientColor, @bg-value 30%)"
                }
              }
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "margin-left": "1rem",
              "margin-right": "1rem",
              "border-radios": "15px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "display": "flex",
                  "justify-content": "space-between",
                  "@media (max-width: 992px)": {
                    "display": "block"
                  },
                  ".item-content": {
                    "position": "relative",
                    "z-index": "1",
                    "width": "40%",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    },
                    ".label-wrapper": {
                      ".item-label": {
                        "display": "inline-block",
                        "margin-bottom": "16px",
                        "background-image": "linear-gradient(90deg, @text_1, @text_2 80%)",
                        "-webkit-background-clip": "text",
                        "-webkit-text-fill-color": "transparent"
                      }
                    },
                    ".item-title": {
                      "margin-bottom": "22px"
                    },
                    ".item-text": {
                      "margin-bottom": "22px"
                    },
                    ".tabs-wrapper": {
                      ".list": {
                        "padding": "0",
                        "margin-bottom": "22px",
                        "list-style-type": "none",
                        "display": "inline-flex",
                        "flex-wrap": "wrap",
                        ".item-wrap": {
                          "position": "relative",
                          "margin": "0 8px 8px 0",
                          "background-color": "@tagsBg",
                          "border": "1px solid @tagsBorder",
                          "padding": "2px 8px"
                        }
                      }
                    }
                  },
                  ".item-img": {
                    "width": "50%",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    },
                    "img": {
                      "height": "370px",
                      "object-fit": "contain",
                      "@media (max-width: 992px)": {
                        "height": "350px"
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "0",
              "width": "40px",
              "height": "40px",
              "font-size": "18px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "z-index": "2",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "box-shadow": "0 0 33px 0 @arrowsBg"
              },
              "&.embla__button--prev": {
                "right": "50px",
                ".mbr-iconfont": {
                  "margin-right": "4px"
                }
              },
              "&.embla__button--next": {
                "right": "0",
                ".mbr-iconfont": {
                  "margin-left": "4px"
                }
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-top": "4rem"
              },
              "& when (@showBorder)": {
                "padding-bottom": "100px",
                "@media (max-width: 992px)": {
                  "padding-bottom": "32px"
                },
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "bottom": "0",
                  "left": "0",
                  "background-image": "radial-gradient(ellipse farthest-corner at 50% 50%, @border 0%, transparent 50%)",
                  "height": "1px",
                  "width": "100%"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".item-label": {
              "color": "#0047ff"
            },
            ".item-title": {
              "color": "#ffffff"
            },
            ".item-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#ffffff"
            }
          },
          "_name": "slider02",
          "_sourceTheme": "emblemm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider02 mbr-embla emblemm5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Border Bottom\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#ffffff\" name=\"border\" condition=\"showBorder\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <input type=\"color\" title=\"Arrows Color\" value=\"#ffffff\" name=\"arrowsColor\" condition=\"arrows\" selected>\n        <input type=\"color\" title=\"Arrows BG\" value=\"#000000\" name=\"arrowsBg\" condition=\"arrows\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Label\" name=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Gradient 1\" value=\"#ffffff\" name=\"text_1\" condition=\"showLabel\">\n        <input type=\"color\" title=\"Label Gradient 2\" value=\"#1f6463\" name=\"text_2\" condition=\"showLabel\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Tags\" name=\"showTags\" checked>\n        <input type=\"color\" title=\"Tags BG\" value=\"#1f6463\" name=\"tagsBg\" condition=\"showTags\">\n        <input type=\"color\" title=\"Tags Border\" value=\"#a0e1e1\" name=\"tagsBorder\" condition=\"showTags\">\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/kronogenesis-megasoma-gif.gif\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#000000\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Gradient Background\" name=\"gradientBg\" condition=\"bg.type=='color'\" checked>\n        <input type=\"color\" title=\"Gradient Color\" name=\"gradientColor\" value=\"#0047ff\" condition=\"gradientBg &&bg.type=='color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport\">\n                            <div class=\"embla__container\">\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                            <div class=\"item-content\">\n                                                <div class=\"label-wrapper\">\n                                                    <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".item-label, .label-wrapper\">\n                                                        Portfolio</p>\n                                                </div>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".item-title, .mbr-section-btn\">Elegance in every detail</h4>\n                                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".item-text\">Luxury Jewelry E-Commerce Website – Where Elegance Meets Convenience<br><br>This website was crafted for a women’s jewelry shop owner looking to create an engaging and visually captivating online store. The goal was to build a seamless shopping experience that highlights the beauty and elegance of each piece while making it easy for customers to browse and purchase.<br>Developed using [WordPress + WooCommerce/ Elementor], this e-commerce platform brings the brand’s elegance online, making fine jewelry accessible with just a few clicks.<br></p>\n                                                <div class=\"tabs-wrapper\">\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .tabs-wrapper\" data-multiline mbr-article mbr-if=\"showTags\">\n                                                        <li class=\"item-wrap\">Wordpress</li>\n                                                        <li class=\"item-wrap\">Elementor</li>\n                                                        <li class=\"item-wrap\">E-commerce</li><li class=\"item-wrap\">Canva</li><li class=\"item-wrap\">SEO</li>\n                                                    </ul>\n                                                </div>\n                                                <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"https://larajewelry.co.il/\" class=\"btn item-btn btn-warning\" data-app-placeholder=\"Type Text\" target=\"_blank\">Visit</a></div>\n                                            </div>\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/1-1000x750.png\" alt=\"Mobirise Website Builder\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                            <div class=\"item-content\">\n                                                <div class=\"label-wrapper\">\n                                                    <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".item-label, .label-wrapper\"></p>\n                                                </div>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".item-title, .mbr-section-btn\">A journey through Julis</h4>\n                                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".item-text\">Julis Village Website – A Digital Gateway to History and Culture<br><br>This website was designed to bring the rich heritage of Julis, a historic village in northern Israel, to life. Built with a modern yet traditional aesthetic, the platform offers an engaging storytelling experience, featuring.<br>Developed with WordPress, the website is designed to preserve Julis’ heritage while making it accessible to visitors and locals alike.<br></p>\n                                                <div class=\"tabs-wrapper\">\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .tabs-wrapper\" data-multiline mbr-article mbr-if=\"showTags\">\n                                                        <li class=\"item-wrap\">Audience</li>\n                                                        <li class=\"item-wrap\">Brand</li>\n                                                        <li class=\"item-wrap\">Platforms</li><li class=\"item-wrap\">SEO</li>\n                                                    </ul>\n                                                </div>\n                                                <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"https://julis.co.il/\" class=\"btn item-btn btn-warning\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                                                        View More\n                                                    </a></div>\n                                            </div>\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/2-700x525.png\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                            <div class=\"item-content\">\n                                                <div class=\"label-wrapper\">\n                                                    <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".item-label, .label-wrapper\">\n                                                        Unleash your inner fighter\n                                                    </p>\n                                                </div>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".item-title, .mbr-section-btn\">Kickboxing Training Website – Power, Precision, Performance</h4>\n                                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".item-text\">\n                                                    This website was built for a certified kickboxing trainer to provide a dynamic platform that showcases training programs, gym facilities, and an easy online sign-up system for new members.<br>Built with [WordPress/Elementor], this website delivers an engaging and user-friendly experience for anyone looking to train like a pro<br>\n                                                </p>\n                                                <div class=\"tabs-wrapper\">\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .tabs-wrapper\" data-multiline mbr-article mbr-if=\"showTags\">\n                                                        <li class=\"item-wrap\">Wordpress</li>\n                                                        <li class=\"item-wrap\">Elementor</li>\n                                                        <li class=\"item-wrap\">Canva</li><li class=\"item-wrap\">SEO</li>\n                                                    </ul>\n                                                </div>\n                                                <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"https://mix-martialarts.com/\" class=\"btn item-btn btn-warning\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                                                        View More\n                                                    </a></div>\n                                            </div>\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/3-700x525.png\" alt=\"Mobirise Website Builder\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                            <div class=\"item-content\">\n                                                <div class=\"label-wrapper\">\n                                                    <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".item-label, .label-wrapper\">\n                                                        A Reflection of My Web Development Journey\n                                                    </p>\n                                                </div>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".item-title, .mbr-section-btn\">Old Portfolio Website</h4>\n                                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".item-text\">This portfolio website served as my previous personal showcase, where I presented my web development projects, skills, and experience in a structured and engaging manner. Designed with a modern dark-themed UI, it featured intuitive navigation, clean layouts, and interactive elements to enhance user experience.<br>While this website effectively demonstrated my abilities at the time, my new portfolio takes my presentation and design to the next level, incorporating updated projects, refined UI/UX, and enhanced interactive features to reflect my current expertise.<br>\n                                                </p>\n                                                <div class=\"tabs-wrapper\">\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .tabs-wrapper\" data-multiline mbr-article mbr-if=\"showTags\">\n                                                        <li class=\"item-wrap\">HTML5</li>\n                                                        <li class=\"item-wrap\">CSS</li>\n                                                        <li class=\"item-wrap\">Javascript</li><li class=\"item-wrap\">Canva</li><li class=\"item-wrap\">SEO</li>\n                                                    </ul>\n                                                </div>\n                                                <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"https://admamr.github.io/website/\" class=\"btn item-btn btn-warning\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                                                        View More\n                                                    </a></div>\n                                            </div>\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/old-portoflio-700x525.png\" alt=\"Mobirise Website Builder\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                            <div class=\"item-content\">\n                                                <div class=\"label-wrapper\">\n                                                    <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".item-label, .label-wrapper\">\n                                                        Turning houses into homes\n                                                    </p>\n                                                </div>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".item-title, .mbr-section-btn\">Real Estate Agency Website – Premium Rentals &amp; Renovations in the USA</h4>\n                                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".item-text\">This website was designed for a real estate agency specializing in renting and renovating apartments and houses in Ohio, USA. The goal was to create a professional, visually appealing, and user-friendly platform that connects potential tenants and homeowners with the agency.<br>Built with [WordPress/Elementor/HTML, CSS, JavaScript], this website ensures that users can effortlessly explore listings, get inspired by renovation projects, and connect with the agency for their real estate needs.<br>\n                                                </p>\n                                                <div class=\"tabs-wrapper\">\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .tabs-wrapper\" data-multiline mbr-article mbr-if=\"showTags\">\n                                                        <li class=\"item-wrap\">Wordpress</li>\n                                                        <li class=\"item-wrap\">Elementor</li><li class=\"item-wrap\">HTML</li><li class=\"item-wrap\">CSS</li><li class=\"item-wrap\">Javascript</li>\n                                                        <li class=\"item-wrap\">Canva</li><li class=\"item-wrap\">SEO</li>\n                                                    </ul>\n                                                </div>\n                                                <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"https://rfglobal.co.il/\" class=\"btn item-btn btn-warning\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                                                        View More\n                                                    </a></div>\n                                            </div>\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/4-700x525.png\" alt=\"Mobirise Website Builder\" data-slide-to=\"4\" data-bs-slide-to=\"4\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uFfEnTslN2",
          "_anchor": "slider02-8",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 60px",
                "@media (max-width: 992px)": {
                  "padding": "0 23px"
                },
                "@media (max-width: 768px)": {
                  "padding": "0 12px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 23px"
              },
              "@media (max-width: 768px)": {
                "padding": "0 12px"
              }
            },
            ".content-wrapper": {
              "display": "flex",
              "border-radius": "32px",
              "padding": "1.5rem",
              "@media (max-width: 768px)": {
                "display": "block",
                "padding": "0.5rem"
              },
              ".title-wrapper": {
                "width": "50%",
                "margin-right": "32px",
                "& when (@reverseContent)": {
                  "margin-right": "0",
                  "margin-left": "32px"
                },
                "@media (max-width: 768px)": {
                  "width": "100%",
                  "padding": "24px",
                  "margin": "0"
                },
                "@media (max-width: 576px)": {
                  "padding": "0px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "1.5rem"
                },
                ".mbr-social-likns .mbr-iconfont": {
                  "border-radius": "50px",
                  "border": "1px solid #fdfde1",
                  "color": "#fdfde1",
                  "transition": "all 300ms ease",
                  "&:hover": {
                    "color": "#bff747",
                    "border-color": "#bff747"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "0"
                }
              },
              ".mbr-form": {
                "width": "40%",
                "@media (max-width: 992px)": {
                  "width": "50%"
                },
                "@media (max-width: 768px)": {
                  "width": "100%"
                },
                ".form-wrap": {
                  "width": "100%",
                  "@media (max-width: 768px)": {
                    "padding": "24px"
                  },
                  "@media (max-width: 576px)": {
                    "padding": "0px"
                  },
                  ".dragArea.row": {
                    ".mbr-section-title": {
                      "margin-bottom": "20px !important"
                    },
                    ".mbr-text": {
                      "margin-bottom": "20px !important"
                    },
                    ".form-group": {
                      "margin-bottom": "16px !important",
                      ".form-control": {
                        "color": "@text",
                        "padding": "1.3rem 1.5rem",
                        "font-weight": "700",
                        "box-shadow": "none",
                        "border-radius": "3rem !important",
                        "border": "1px solid @border !important",
                        "background-color": "@inputBg",
                        "transition": "all 300ms ease",
                        "&:hover, &:focus": {
                          "border": "1px solid @borderActive !important",
                          "box-shadow": "none"
                        },
                        "&::placeholder": {
                          "color": "@border"
                        }
                      },
                      "textarea.form-control": {
                        "min-height": "150px",
                        "border-radius": "1.3rem !important"
                      },
                      ".form-check": {
                        "padding-left": "1.7em",
                        "margin-bottom": "10px",
                        ".form-check-input": {
                          "background-color": "@border",
                          "border-color": "@border"
                        }
                      }
                    },
                    ".mbr-section-btn": {
                      "margin-top": "6px",
                      ".btn": {
                        "width": "100%",
                        "padding": "1.25rem 1.5rem"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-form .form-conrol": {
              "color": "@text"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#fdfde1"
            },
            "label": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#fdfde1"
            },
            ".card-contacts": {
              "color": "#a0e1e1"
            }
          },
          "_name": "form01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 range5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"checkbox\" title=\"Social Icons\" name=\"showSocialIcons\" checked>\n        <input type=\"range\" title=\"Count\" name=\"iconCount\" min=\"0\" max=\"5\" step=\"1\" value=\"2\" condition=\"showSocialIcons\">\n        <header>Form</header>\n        <input type=\"color\" title=\"Text\" value=\"#fdfde1\" name=\"text\" selected>\n        <input type=\"color\" title=\"Input BG\" value=\"#000000\" name=\"inputBg\" selected>\n        <input type=\"color\" title=\"Input Border\" value=\"#fdfde1\" name=\"border\" selected>\n        <input type=\"color\" title=\"Input Border Active\" value=\"#a0e1e1\" name=\"borderActive\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/rangem5/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/rangem5/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"title-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>&nbsp;Let's start a project together</b></h2>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                            I work closely with my clients to understand their objectives, target audience, and unique\n                            needs. I use my creative skills to translate these requirements and practical design\n                            solutions.<br>\n                        </p><br>\n                        <p class=\"card-contacts mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" mbr-if=\"showContacts\" data-app-selector=\".card-contacts\">\n                            Give me a call:<br><a href=\"https://wa.me/972543006115\" class=\"text-white\">+972-543006115</a></p>\n                        <p class=\"card-contacts mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showContacts\" data-app-selector=\".card-contacts\">\n                            Send me an email:<br><i><a href=\"mailto:admamr.227@gmail.com\" class=\"text-white\">admamr.227@gmail.com</a></i></p>\n                        <div class=\"mbr-social-likns align-left mb-0\" data-counters=\"false\" mbr-if=\"iconCount > 0 &amp;&amp; showSocialIcons\">\n                            <a class=\"iconfont-wrapper ms-0\" href=\"https://github.com/admamr\" target=\"_blank\" mbr-if=\"iconCount > 0\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-github socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://www.linkedin.com/in/adam-amar1/\" target=\"_blank\" mbr-if=\"iconCount > 1\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconCount > 2\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconCount > 3\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-youtube socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconCount > 4\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-pinterest socicon\"></span>\n                            </a>\n                        </div>\n                    </div>\n                    <div mbr-form class=\"ms-auto mbr-form\">\n                        <!--Formbuilder Form-->\n                        <form action=\"admamr.227@gmail.com\" name=\"range5\" method=\"POST\" class=\"mbr-form form-with-styler form-wrap\" data-verified=\"admamr.227@gmail.com\">\n                            <div class=\"row\">\n                                <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">I we'll reach back ASAP, thank you</div>\n                                <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">\n                                    Oops...!\n                                    some problem! </div>\n                            </div>\n                            <div class=\"dragArea row\">\n                                <div class=\"col-lg-12 col-md-12 col-sm-12\">\n                                    <h3 mbr-theme-style=\"display-5\" class=\"mbr-section-title mbr-fonts-style\">Send me a\n                                        message</h3>\n                                </div>\n                                <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"text\">\n                                    <input type=\"text\" name=\"text\" placeholder=\"Your name\" data-form-field=\"text\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value>\n                                </div>\n                                <div data-for=\"email\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n                                    <input type=\"email\" name=\"email\" placeholder=\"Your email address\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n                                </div>\n                                <div data-for=\"tel\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n                                    <input type=\"tel\" name=\"tel\" placeholder=\"Your phone number\" data-form-field=\"tel\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n                                </div>\n                                <div data-for=\"textarea\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n                                    <textarea name=\"textarea\" placeholder=\"Write your message here...\" data-form-field=\"textarea\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\"></textarea>\n                                </div>\n                                <div class=\"col-lg-12 col-md-12 col-sm-12 mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"w-100 w-100 btn btn-warning\" data-app-placeholder=\"Type Text\">Send Now</a></div>\n                            </div>\n                        </form><!--Formbuilder Form-->\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uFgjyiJC2D",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "form01-a"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".media-container-row .mbr-text": {
              "color": "#fdfde1"
            }
          },
          "_name": "footer02",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer2\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/rangem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row align-center mbr-white\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\">\n                    © Copyright Adam Amar - Web Designer/Developer -All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uFgl1UjMSH",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {},
          "_anchor": "footer02-b"
        }
      ]
    }
  }
}