              "color": "#4b4b4b"
            }
          },
          "_name": "article03",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article03 range5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\">\n        <header>Image</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" name=\"borderColor\" value=\"#4b4b4b\" selected condition=\"showBorder == true\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#fffff5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row items-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-7 card\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>✨ Work Experince</b></h2>\n                    <p class=\"item-text mbr-fonts-style mb-3\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\"></p>\n                    <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Web Developer - Creative LTD.&nbsp;<br></h3>\n                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">• Spearheaded the design and development of WordPress websites with a strong&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;focus on UX/UI, performance optimization, and SEO strategies.<br><br>• Managed multiple projects simultaneously, ensuring deadlines, budgets, and client<br>&nbsp;expectations were met.<br><br>• Troubleshot CMS-related issues and implemented fixes for plugin conflicts, theme errors, and performance bottlenecks.<br><br>• Integrated Google Analytics, SEO tools, and caching mechanisms to improve&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;website rankings and loading speed.<br><br>• Worked closely with remote developers, designers, and marketers to align&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;branding and content strategies.</p>\n                    <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">---------------------------------------------------------------------------</h3>\n                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-5\" data-app-selector=\".item-text\">Wordpress Designer - Freelancer&nbsp;</p>\n                    <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">• Designed and developed custom WordPress websites using Elementor, custom themes, and plugins, ensuring mobile responsiveness and SEO optimization.<br><br>• Maintained and troubleshot website issues, optimizing performance, security, and&nbsp;<span style=\"font-size: 1.3rem; background-color: transparent;\">functionality for international clients.</span><div><span style=\"font-size: 1.3rem; background-color: transparent;\"><br></span></div><div>• Integrated third-party APIs, plugins, and payment gateways to enhance eCommerce&nbsp;<span style=\"font-size: 1.3rem; background-color: transparent;\">and dynamic site functionality.</span></div><div><span style=\"font-size: 1.3rem; background-color: transparent;\"><br></span></div><div>• Collaborated with overseas clients and development teams via Slack, Trello, and Asana,&nbsp;<span style=\"font-size: 1.3rem; background-color: transparent;\">ensuring seamless remote communication and timely project delivery.</span></div><div><span style=\"font-size: 1.3rem; background-color: transparent;\"><br></span></div><div>• Provided CMS training and documentation for clients to manage content efficiently.</div></h3>\n                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\"></p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            Read more\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 card m-auto\">\n                <div class=\"image-wrapper\">\n                    <img src=\"../_images/team.jpeg\" alt=\"Mobirise\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uEYAukwIkA",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "article03-2"
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr",
              "gap": "32px",
              "padding": "80px 60px",
              "overflow": "hidden",
              "@media (max-width: 1200px)": {
                "gap": "16px"
              },
              "@media (max-width: 1199px)": {
                "grid-template-columns": "1fr 1fr"
              },
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "32px 16px"
              },
              "& when (@showImage)": {
                "border": "2px solid @borderImage"
              },
              ".image-wrapper": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "opacity": ".5"
                }
              },
              ".item": {
                "@media (max-width: 992px)": {
                  "margin-bottom": "16px",
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                },
                ".item-wrapper": {
                  "position": "relative",
                  "height": "100%",
                  "border": "3px solid @border",
                  "box-shadow": "4px 4px 0 0 @border",
                  "transition": "all 0.3s ease-in-out",
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  "overflow": "hidden",
                  "background-color": "@card",
                  "&:hover, &:focus": {
                    "transform": "translate(0.2rem, 0.2rem)",
                    "box-shadow": "none"
                  },
                  ".item-content": {
                    ".item-img": {
                      "border-bottom": "3px solid @border",
                      "img": {
                        "height": "390px",
                        "width": "100%",
                        "object-fit": "contain",
                        "border-radius": "0 !important",
                        "@media (max-width: 992px)": {
                          "height": "350px"
                        }
                      },
                      "&::before": {
                        "content": "''",
                        "position": "absolute",
                        "top": "0",
                        "left": "0",
                        "width": "100%",
                        "height": "100%",
                        "pointer-events": "none",
                        "opacity": ".8"
                      }
                    },
                    ".text-wrapper": {
                      "padding": "32px",
                      "@media (max-width: 1440px)": {
                        "padding": "32px 24px"
                      },
                      "@media (max-width: 992px)": {
                        "padding": "32px 16px"
                      },
                      ".item-title": {
                        "margin-bottom": "48px",
                        "@media (max-width: 992px)": {
                          "margin-bottom": "24px"
                        }
                      },
                      ".item-text": {
                        "margin-bottom": "16px",
                        "@media (max-width: 992px)": {
                          "margin-bottom": "0"
                        }
                      }
                    }
                  },
                  ".tags-wrapper": {
                    "padding": "0 32px 24px 32px",
                    "@media (max-width: 1440px)": {
                      "padding": "0 24px 24px 24px"
                    },
                    "@media (max-width: 992px)": {
                      "padding": "0 16px 24px 16px"
                    },
                    ".list": {
                      "display": "inline-flex",
                      "flex-wrap": "wrap",
                      "margin": "0",
                      "padding": "0",
                      "list-style-type": "none",
                      ".item-wrap": {
                        "display": "inline-flex",
                        "padding": "11px 20px",
                        "margin": "0 8px 8px 0",
                        "background-color": "@tag_1",
                        "&:nth-child(2n)": {
                          "background-color": "@tag_2"
                        },
                        "&:nth-child(3n)": {
                          "background-color": "@tag_3"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".item-title": {
              "color": "#050f0f"
            },
            ".item-text": {
              "color": "#050f0f"
            },
            ".list": {
              "color": "#050f0f"
            }
          },
          "_name": "features03",
          "_sourceTheme": "servicem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 servicem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Image BG\" name=\"showImage\" checked>\n        <input type=\"color\" title=\"Image Border Color\" value=\"#ffb2ef\" name=\"borderImage\" condition=\"showImage\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Tags\" name=\"showTags\" checked>\n        <input type=\"color\" title=\"Tags BG 1\" value=\"#d3f2ff\" name=\"tag_1\" selected>\n        <input type=\"color\" title=\"Tags BG 2\" value=\"#bafca2\" name=\"tag_2\" selected>\n        <input type=\"color\" title=\"Tags BG 3\" value=\"#fdfd96\" name=\"tag_3\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#050f0f\" name=\"border\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Card BG\" value=\"#f7fff7\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/animation-design-gif-by-megan-palero.gif\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#f7fff7\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/servicem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7fff7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                        <img src=\"@PROJECT_PATH@/assets/images/animation-design-gif-by-megan-palero.gif\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-content\">\n                                <div class=\"item-img\">\n                                    <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/laraj-772x515.png\" alt=\"Mobirise\"></a>\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                        <b><a href=\"https://larajewelry.co.il/\" class=\"text-black\" target=\"_blank\">E-commerce Website Development</a></b>\n                                    </h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                        Creating an e-commerce website is a complex and multifaceted project that requires\n                                        integrating various functionalities to provide a seamless shopping experience.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .tags-wrapper\" data-multiline mbr-article>\n                                    <li class=\"item-wrap\">Wordpress</li>\n                                    <li class=\"item-wrap\">Elementor</li><li class=\"item-wrap\">Canva</li><li class=\"item-wrap\">E-commerce</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                     <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-content\">\n                                <div class=\"item-img\">\n                                    <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/rf-772x515.png\" alt=\"Mobirise\"></a>\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                        <b><a href=\"https://rfglobal.co.il/\" class=\"text-black\" target=\"_blank\">Real-Estate Investment Website&nbsp;</a></b></h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                        Designed &amp; Developed a high-performance real estate investment website using WordPress and Elementor, ensuring a sleek, modern, and user-friendly experience.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .tags-wrapper\" data-multiline mbr-article>\n                                    <li class=\"item-wrap\">Wordpress</li>\n                                    <li class=\"item-wrap\">Elementor</li>\n                                    <li class=\"item-wrap\">Canva</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-content\">\n                                <div class=\"item-img\">\n                                    <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/julis-772x515.png\" alt=\"Mobirise\"></a>\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"https://julis.co.il/\" class=\"text-primary\" target=\"_blank\">Community Hub for a Northern Israeli Julis Village</a></h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Designed &amp; Developed a community-driven website for a small village in northern Israel, using WordPress and Elementor to create a visually appealing and functional platform tailored to the village’s needs\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .tags-wrapper\" data-multiline mbr-article>\n                                    <li class=\"item-wrap\">Wordpress</li>\n                                    <li class=\"item-wrap\">Elementor</li>\n                                    <li class=\"item-wrap\">Canva</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-content\">\n                                <div class=\"item-img\">\n                                    <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/mixmartialarts-612x408.png\" alt=\"Mobirise\"></a>\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                      <b> <a href=\"https://mix-martialarts.com/\" class=\"text-black text-primary\" target=\"_blank\">Kickboxing GYM Website Design</a></b></h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                        Designed &amp; Developed a high-energy, dynamic website for a kickboxing gym, using WordPress and Elementor to create a visually engaging and user-friendly platform that attracts new members and enhances the gym’s online presence\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .tags-wrapper\" data-multiline mbr-article>\n                                    <li class=\"item-wrap\">DATABASE</li>\n                                    <li class=\"item-wrap\">Elementor<br></li>\n                                    <li class=\"item-wrap\">Canva</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uEYEf09Y4p",
          "_anchor": "features03-3",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
