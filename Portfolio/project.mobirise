              "color": "#bff747"
            },
            ".image-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "32px"
              },
              "img": {
                "& when (@showBorder)": {
                  "border-radius": "2rem",
                  "padding": "5px",
                  "background-color": "@borderColor"
                },
                "height": "500px",
                "width": "100%",
                "object-fit": "cover",
                "@media (max-width: 992px)": {
                  "height": "350px"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#fdfde1"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#fdfde1"
            },
            ".mbr-desc": {
              "color": "#fdfde1"
            },
            ".mbr-section-subtitle": {
              "color": "#fdfde1"
            },
