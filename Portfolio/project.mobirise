              }
            },
            ".card": {
              ".item-wrapper": {
                "background-color": "@card",
                "transition": "all 0.3s ease",
                ".card-box": {
                  "padding": "3rem 1.5rem",
                  "min-height": "500px",
                  "@media (max-width: 992px)": {
                    "padding": "36px 24px",
                    "min-height": "auto"
                  },
                  ".item-number": {
                    "margin-bottom": "32px"
                  },
                  ".item-title": {
                    "margin-bottom": "32px"
                  },
                  ".item-text": {
                    "margin-bottom": "0",
                    "line-height": "1.66"
                  },
                  ".icon-wrap": {
                    "font-size": "3rem",
                    "color": "@iconCard"
                  }
                },
                "&:hover": {
                  "box-shadow": "5px 5px 0 0 @hoverCardShadowColor",
                  "transform": "translateY(-1.15rem)"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".item-title": {
              "color": "#fdfde1"
            },
            ".item-number": {
              "color": "#ffffff"
            },
            ".item-text": {
              "color": "#fdfde1"
            }
          },
          "_name": "features02",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features02 range5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#000000\" name=\"iconTitle\" condition=\"showIconTitle\" selected>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIconCard\">\n        <input type=\"color\" title=\"Color\" value=\"#fdfde1\" name=\"iconCard\" condition=\"showIconCard\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"BG\" value=\"#000000\" name=\"card\" selected>\n        <input type=\"color\" title=\"Hover Shadow\" name=\"hoverCardShadowColor\" value=\"#666666\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#fffff5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row title\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Elevate your online presence.</b></h2>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\">\n                <div class=\"icon-wrap\" mbr-if=\"showIconTitle\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-growing-chart mobi-mbri\"></span>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrap\">\n            <div class=\"card col-12 col-lg-4 active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrap\" mbr-if=\"showIconCard\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-responsive mobi-mbri\"></span>\n                        </div>\n                        <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>Web Design</b></h3>\n                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">A creative professional specializing in web design, a web designer crafts visually appealing and user-friendly websites. With an eye for aesthetics and a focus on user experience, I use my design skills to create engaging layouts, graphics, and interfaces that enhance the overall look.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4 card_2\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrap\" mbr-if=\"showIconCard\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-photo mobi-mbri\"></span>\n                        </div>\n                        <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>Web Development</b></h3>\n                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">A skilled web developer with proficient in coding and programming, turning design concepts into functional websites. I work with various programming languages and frameworks to build the backend and frontend of websites, ensuring seamless navigation, responsiveness, and optimal performance.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4 card_3\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrap\" mbr-if=\"showIconCard\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-sites mobi-mbri\"></span>\n                        </div>\n                        <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>Search Engine Optimization</b></h3>\n                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                            An SEO specialist who's dedicated to optimizing websites for search engines. I employ strategies to improve a site's visibility in search engine results, conducting keyword research, optimizing content, and implementing technical SEO practices. My goal is to enhance organic traffic and ensure that the website ranks well in search engine listings.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
