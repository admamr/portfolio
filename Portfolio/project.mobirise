            ".title-wrapper": {
              ".mbr-desc": {
                "margin-bottom": "15px"
              },
              ".mbr-section-title": {
                "margin-bottom": "64px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px"
                }
              },
              "@media (max-width: 992px)": {
                "text-align": "center"
              }
            },
