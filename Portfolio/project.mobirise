          "_name": "article02",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article02 range5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/gif-artist-glow-gif-by-erica-anderson.gif\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\">\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        Read more\n                    </a>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        The Role\n                    </h2>\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\">\n                        Innovative solutions for You\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-7\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .text-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showText\">I'm a Driven &amp; Innovative Web Designer and Developer with a Proven Track-Record of Delivering High-Impact, User-Centric websites.<br></p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uw6ARJxL7y",
          "_anchor": "article02-3",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_PHPplaceholders": [],
          "_JSplaceholders": []
        },
        {
          "_name": "tabs01",
          "_sourceTheme": "tokenm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs01 tabs tokenm5\" group=\"List\" plugins=\"mbr-tabs\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <input type=\"color\" title=\"Tabs Color\" value=\"#cbff5b\" name=\"tabs\" selected>\n        <input type=\"color\" title=\"Tabs Active Color\" value=\"#000000\" name=\"active\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Image Gradient\" name=\"showGradient\" checked>\n        <input type=\"color\" title=\"Gradient Color\" value=\"#cbff5b\" name=\"gradientColor\" condition=\"showGradient\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/tokenm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/tokenm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#060606\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .tabs-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                        <b>Top In-Demand Currencies</b>\n                    </h2>\n                </div>\n                <div class=\"tabs-wrapper\">\n                    <ul class=\"nav nav-tabs\" role=\"tablist\">\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link show mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs01-0_tab0\" aria-selected=\"true\">\n                                <strong>Web Design</strong>\n                            </a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs01-0_tab1\" aria-selected=\"true\">\n                                <strong>Web Development</strong>\n                            </a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs01-0_tab2\" aria-selected=\"true\">\n                                <strong>SEO</strong>\n                            </a></li>\n                        <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs01-0_tab3\" aria-selected=\"true\">\n                                <strong>Soft Skills</strong>\n                            </a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"tab-content\">\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                        <div class=\"item-content\">\n                            <div class=\"image-wrap\">\n                                <img src=\"@PROJECT_PATH@/assets/images/download.gif\" alt=\"Mobirise\">\n                            </div>\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\"><b>Web Design</b></h4>\n                            <div class=\"text-wrapper\">\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text, .text-wrapper\" mbr-if=\"showText\">. Custom WordPress website creation&nbsp;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <br>. SEO-friendly design practices<br>&nbsp; &nbsp; &nbsp;&nbsp;<br>.&nbsp;Advanced Elementor design &amp; customization.&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<br><br>. Design consistency &amp; aesthetics<br>&nbsp;<br>.&nbsp;Fully responsive &amp; mobile friendly layouts.&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<br><br>. Call-to-action (CTA) optimization<br><br>.&nbsp;HTML5 &amp; CSS3 for pixel-perfect designs&nbsp;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<br>. Design consistency &amp; aesthetics&nbsp;&nbsp;<br><br>.&nbsp;CSS animations &amp; transitions for interactive UI&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <br><br>. Landing page &amp; conversion optimization<br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                        <div class=\"item-content\">\n                            <div class=\"image-wrap\">\n                                <img src=\"@PROJECT_PATH@/assets/images/programmer-coding-gif.gif\" alt=\"Mobirise\">\n                            </div>\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">\n                                <b>Web Development</b></h4>\n                            <div class=\"text-wrapper\">\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text, .text-wrapper\" mbr-if=\"showText\">\n                                    .&nbsp;HTML5, CSS3, JavaScript (ES6+)<br>&nbsp;&nbsp; &nbsp; &nbsp; &nbsp;<br>. Secure coding practices &amp; SSL implementation<br><br>.&nbsp;Responsive &amp; mobile-first web development.&nbsp; &nbsp;&nbsp;<br><br>. Website backups &amp; maintenance<br><br>.&nbsp;CSS frameworks (Tailwind, Bootstrap)&nbsp; &nbsp; <br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<br>. Server &amp; hosting setup (cPanel, Cloudflare)<br><br>. Cross-browser compatibility &amp;&nbsp;performance optimization <br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<br>. JavaScript libraries (GSAP, ScrollMagic) &nbsp;<br> &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<br>. Interactive UI/UX with animations &amp; transitions&nbsp; &nbsp; <br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<br>. API integration &amp; data handling<br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                        <div class=\"item-content\">\n                            <div class=\"image-wrap\">\n                                <img src=\"@PROJECT_PATH@/assets/images/consulting-digital-marketing-gif-by-voxel.gif\" alt=\"Mobirise\">\n                            </div>\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\"><b>Search Engine Optimization</b></h4>\n                            <div class=\"text-wrapper\">\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text, .text-wrapper\" mbr-if=\"showText\">. Website speed optimization.<br><br>.&nbsp;Meta tags (title, description, headers)<br><br>.&nbsp;Mobile-first design &amp; optimization<br><br>.&nbsp;XML sitemaps &amp; robots.txt management<br><br>.&nbsp;Keyword research &amp; optimization<br><br>.&nbsp;Google Analytics &amp; Search Console<br><br>. Rank tracking &amp; competitor analysis<br><br>.&nbsp;Local SEO (Google My Business, citations)<br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                        <div class=\"item-content\">\n                            <div class=\"image-wrap\">\n                                <img src=\"@PROJECT_PATH@/assets/images/jimmy-fallon-skills-gif-by-the-tonight-show-starring-jimmy-fallon.gif\" alt=\"Mobirise\">\n                            </div>\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">\n                                <b>Soft Skills</b></h4>\n                            <div class=\"text-wrapper\">\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text, .text-wrapper\" mbr-if=\"showText\">\n                                    .&nbsp;Ability to lead projects and work seamlessly with designers, developers and clients.<br><br>.&nbsp;Strong ability to understand client needs and translate them into effective web solutions.<br><br>.&nbsp;Quick adaptability to troubleshoot&nbsp; issues and provide innovative solutions.<br><br>. Efficiently manage tight deadlines and high-demand projects without compromising quality.<br><br>.&nbsp;Clear and professional communication with clients and team members.<br><br>.&nbsp;Staying updated with the latest web technologies, trends, and best practices.<br></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".card": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "60px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "30px"
                }
              }
            },
            ".tabs-wrapper": {
              "border-bottom": "none",
              "@media (max-width: 992px)": {
                "margin-bottom": "30px"
              },
              ".nav.nav-tabs": {
                "border": "none",
                "padding": "0",
                "border-radius": "0 !important",
                "background-color": "transparent",
                "display": "inline-block",
                ".nav-item": {
                  "padding": "0",
                  "border": "none",
                  "display": "block",
                  "margin-bottom": "16px",
                  ".nav-link": {
                    "display": "flex",
                    "color": "@tabs",
                    "padding": "11px 64px",
                    "border": "2px solid @tabs",
                    "transition": "all 0.3s ease-in-out",
                    "align-items": "center",
                    "justify-content": "center",
                    "min-height": "88px",
                    "@media (max-width: 992px)": {
                      "min-height": "54px",
                      "padding": "11px 32px"
                    }
                  },
                  ".nav-link.active": {
                    "background-color": "@tabs",
                    "color": "@active"
                  }
                }
              }
            },
            ".tab-content": {
              ".tab-pane": {
                ".item-content": {
                  "border": "none",
                  "background-color": "transparent",
                  ".image-wrap": {
                    "position": "relative",
                    "margin-bottom": "40px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "30px"
                    },
                    "& when (@showGradient)": {
                      "&::before": {
                        "content": "''",
                        "position": "absolute",
                        "width": "110%",
                        "height": "110%",
                        "border-radius": "100%",
                        "background-image": "radial-gradient(@gradientColor, transparent)",
                        "filter": "blur(100px)"
                      }
                    },
                    "img": {
                      "position": "relative",
                      "z-index": "1",
                      "height": "450px",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "350px",
                        "object-fit": "contain"
                      }
                    }
                  },
                  ".item-title": {
                    "position": "relative",
                    "z-index": "1",
                    "margin-bottom": "40px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "30px"
                    }
                  },
                  ".text-wrapper": {
                    "position": "relative",
                    "z-index": "1",
                    ".item-text": {
                      "display": "inline-flex",
                      "width": "100%",
                      "margin-bottom": "0",
                      "@media (max-width: 992px)": {
                        "width": "100%"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".item-title": {
              "color": "#cbff5b"
            },
            ".item-text": {
              "color": "#ffffff"
            },
            ".item-text, .text-wrapper": {
              "text-align": "left"
            }
          },
