          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 60px",
                "@media (max-width: 992px)": {
                  "padding": "0 23px"
                },
                "@media (max-width: 768px)": {
                  "padding": "0 12px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 23px"
              },
              "@media (max-width: 768px)": {
                "padding": "0 12px"
              }
            },
            ".content-wrapper": {
              "display": "flex",
              "border-radius": "32px",
              "padding": "1.5rem",
              "@media (max-width: 768px)": {
                "display": "block",
                "padding": "0.5rem"
              },
              ".title-wrapper": {
                "width": "50%",
                "margin-right": "32px",
                "& when (@reverseContent)": {
                  "margin-right": "0",
                  "margin-left": "32px"
                },
                "@media (max-width: 768px)": {
                  "width": "100%",
                  "padding": "24px",
                  "margin": "0"
                },
                "@media (max-width: 576px)": {
                  "padding": "0px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "1.5rem"
                },
                ".mbr-social-likns .mbr-iconfont": {
                  "border-radius": "50px",
                  "border": "1px solid #fdfde1",
                  "color": "#fdfde1",
                  "transition": "all 300ms ease",
                  "&:hover": {
                    "color": "#bff747",
                    "border-color": "#bff747"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "0"
                }
              },
              ".mbr-form": {
                "width": "40%",
                "@media (max-width: 992px)": {
                  "width": "50%"
                },
                "@media (max-width: 768px)": {
                  "width": "100%"
                },
                ".form-wrap": {
                  "width": "100%",
                  "@media (max-width: 768px)": {
                    "padding": "24px"
                  },
                  "@media (max-width: 576px)": {
                    "padding": "0px"
                  },
                  ".dragArea.row": {
                    ".mbr-section-title": {
                      "margin-bottom": "20px !important"
                    },
                    ".mbr-text": {
                      "margin-bottom": "20px !important"
                    },
                    ".form-group": {
                      "margin-bottom": "16px !important",
                      ".form-control": {
                        "color": "@text",
                        "padding": "1.3rem 1.5rem",
                        "font-weight": "700",
                        "box-shadow": "none",
                        "border-radius": "3rem !important",
                        "border": "1px solid @border !important",
                        "background-color": "@inputBg",
                        "transition": "all 300ms ease",
                        "&:hover, &:focus": {
                          "border": "1px solid @borderActive !important",
                          "box-shadow": "none"
                        },
                        "&::placeholder": {
                          "color": "@border"
                        }
                      },
                      "textarea.form-control": {
                        "min-height": "150px",
                        "border-radius": "1.3rem !important"
                      },
                      ".form-check": {
                        "padding-left": "1.7em",
                        "margin-bottom": "10px",
                        ".form-check-input": {
                          "background-color": "@border",
                          "border-color": "@border"
                        }
                      }
                    },
                    ".mbr-section-btn": {
                      "margin-top": "6px",
                      ".btn": {
                        "width": "100%",
                        "padding": "1.25rem 1.5rem"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-form .form-conrol": {
              "color": "@text"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#fdfde1"
            },
            "label": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#fdfde1"
            },
            ".card-contacts": {
              "color": "#fdfde1"
            }
          },
          "_name": "form01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 range5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"checkbox\" title=\"Social Icons\" name=\"showSocialIcons\" checked>\n        <input type=\"range\" title=\"Count\" name=\"iconCount\" min=\"0\" max=\"5\" step=\"1\" value=\"2\" condition=\"showSocialIcons\">\n        <header>Form</header>\n        <input type=\"color\" title=\"Text\" value=\"#fdfde1\" name=\"text\" selected>\n        <input type=\"color\" title=\"Input BG\" value=\"#000000\" name=\"inputBg\" selected>\n        <input type=\"color\" title=\"Input Border\" value=\"#fdfde1\" name=\"border\" selected>\n        <input type=\"color\" title=\"Input Border Active\" value=\"#bff747\" name=\"borderActive\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"title-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>✨ Let's start a project together</b></h2>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                            I work closely with my clients to understand their objectives, target audience, and unique\n                            needs. I use my creative skills to translate these requirements and practical design\n                            solutions.<br>\n                        </p><br>\n                        <p class=\"card-contacts mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" mbr-if=\"showContacts\" data-app-selector=\".card-contacts\">\n                            Give mr a call:<br><a href=\"https://wa.me/972543006115\" class=\"text-primary\">+972-54-300-6115</a></p>\n                        <p class=\"card-contacts mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showContacts\" data-app-selector=\".card-contacts\">\n                            Send me an email:<br><a href=\"mailto:admamr.227@gmail.com\" class=\"text-primary\">admamr.227@gmail.com</a></p>\n                        <div class=\"mbr-social-likns align-left mb-0\" data-counters=\"false\" mbr-if=\"iconCount > 0 &amp;&amp; showSocialIcons\">\n                            <a class=\"iconfont-wrapper ms-0\" href=\"https://github.com/admamr\" target=\"_blank\" mbr-if=\"iconCount > 0\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont mbri-github\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://www.linkedin.com/in/adam-amar1/\" target=\"_blank\" mbr-if=\"iconCount > 1\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://github.com/admamr\" target=\"_blank\" mbr-if=\"iconCount > 2\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont mbri-github\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://www.linkedin.com/in/adam-amar1/\" target=\"_blank\" mbr-if=\"iconCount > 3\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconCount > 4\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-pinterest socicon\"></span>\n                            </a>\n                        </div>\n                    </div>\n                    <div mbr-form class=\"ms-auto mbr-form\">\n                        <!--Formbuilder Form-->\n                        <form action=\"admamr.227@gmail.com\" name=\"range5\" method=\"POST\" class=\"mbr-form form-with-styler form-wrap\" data-verified=\"admamr.227@gmail.com\">\n                            <div class=\"row\">\n                                <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for\n                                    filling out the form!</div>\n                                <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">\n                                    Oops...!\n                                    some problem! </div>\n                            </div>\n                            <div class=\"dragArea row\">\n                                <div class=\"col-lg-12 col-md-12 col-sm-12\">\n                                    <h3 mbr-theme-style=\"display-5\" class=\"mbr-section-title mbr-fonts-style\">Send me a\n                                        message</h3>\n                                </div>\n                                <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"text\">\n                                    <input type=\"text\" name=\"text\" placeholder=\"Your name\" data-form-field=\"text\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value>\n                                </div>\n                                <div data-for=\"email\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n                                    <input type=\"email\" name=\"email\" placeholder=\"Your email address\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n                                </div>\n                                <div data-for=\"tel\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n                                    <input type=\"tel\" name=\"tel\" placeholder=\"Your phone number\" data-form-field=\"tel\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n                                </div>\n                                <div data-for=\"textarea\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n                                    <textarea name=\"textarea\" placeholder=\"Write your message here...\" data-form-field=\"textarea\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\"></textarea>\n                                </div>\n                                <div class=\"col-lg-12 col-md-12 col-sm-12 mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n                                    <a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 w-100 btn btn-primary\">Send Now</a>\n                                </div>\n                            </div>\n                        </form><!--Formbuilder Form-->\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uEYIaREsIs",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "form01-4"
        }
      ]
    }
  }
}